# 知乎开放平台 Access Secret（https://developer.zhihu.com/profile 申请）
# 不配置时服务端自动进入「演示数据」模式，前端会有醒目标识。
ZHIHU_ACCESS_SECRET=

# 服务端口
PORT=8787

# ---- 知乎 OAuth（黑客松「我的观点画像」功能）----
# 赛事页面分配的 App ID（公开标识，可以下发前端）
ZHIHU_OAUTH_APP_ID=
# 赛事页面分配的 App Key（仅服务端换取 OAuth Token 用；
# 绝不写进前端、日志、截图、报告或任何响应体）
ZHIHU_OAUTH_APP_KEY=
# 在赛事页面登记的公网回调地址，必须与登记值完全一致，
# 形如 https://your-domain.example/auth/callback
# 留空 = 尚未部署：服务端拒绝发起授权跳转（DEPLOYMENT_REQUIRED），
# 前端「授权知乎账号」按钮置灰；localhost/127.0.0.1 无法完成知乎登录
ZHIHU_OAUTH_REDIRECT_URI=
